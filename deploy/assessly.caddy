# Installed to /srv/caddy/sites/ on the shared box; imported by CodeSync's Caddyfile.
# Caddy gets and renews the HTTPS certificate itself.
assessly.ddnsgeek.com {
	encode zstd gzip

	handle /api/* {
		reverse_proxy assessly-api:8000
	}

	handle {
		root * /srv/www/assessly

		# Vite puts a content hash in every filename under /assets, so they never change
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}
}
